# Python bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/
.frappe

# Node / frontend deps (also catches stray node_modules symlinks)
node_modules
yarn-error.log

# //// Neoffice (version-15): built SPA output (public/frontend, www/*.html,
# service-worker) IS committed — commit-the-build like the other fleet SPAs,
# instances never rebuild the frontend. Bench bundles (public/dist) stay
# ignored: rebuilt on-instance by `bench build --app suite`. ////
/suite/**/public/dist/

# Migrated Node sidecar build output (sfu-server / collab-server also carry own .gitignore)
/suite/meet/sfu-server/dist/

# Mail: auto-downloaded Stalwart control binary (lives at apps/suite/stalwart-cli)
stalwart-cli

# Editor / OS
.DS_Store
*.swp
*.swo
